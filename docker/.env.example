# Docker Compose environment
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=examuser
MYSQL_PASSWORD=exampassword
MYSQL_HOST_PORT=3307
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=8080

SECRET_KEY=replace-with-a-long-random-secret
